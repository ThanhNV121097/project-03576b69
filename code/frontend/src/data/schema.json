      "fields": [
        { "key": "question", "label": "Question", "type": "text" },
        { "key": "answer", "label": "Answer", "type": "longtext" }
      ]
    },
    "orders": {
      "label": "Past orders",
      "fields": [
        { "key": "placed", "label": "Placed on", "type": "text" },
        { "key": "status", "label": "Status", "type": "text" },
        { "key": "total", "label": "Total", "type": "price", "currency": "USD" },
        { "key": "items", "label": "What was in it", "type": "text" }
