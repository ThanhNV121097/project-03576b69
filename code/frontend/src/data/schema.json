        { "key": "name", "label": "Name", "type": "text" },
        { "key": "category", "label": "Category", "type": "ref:categories" },
        { "key": "price", "label": "Price", "type": "price", "currency": "USD" },
        { "key": "oldPrice", "label": "Old price", "type": "price", "currency": "USD" },
        { "key": "unit", "label": "Unit", "type": "text" },
        { "key": "summary", "label": "Short description", "type": "text" },
        { "key": "details", "label": "Details", "type": "longtext" },
        { "key": "image", "label": "Picture", "type": "image" },
        { "key": "featured", "label": "Featured", "type": "bool" },
        { "key": "available", "label": "Available", "type": "bool" },
        { "key": "stock", "label": "In stock", "type": "number" },
        { "key": "specs", "label": "Specifications", "type": "list" }
      ]
    },
    "categories": {
      "label": "Categories",
      "fields": [
        { "key": "name", "label": "Name", "type": "text" },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "image", "label": "Picture", "type": "image" }
      ]
    },
    "reviews": {
      "label": "Customer reviews",
      "fields": [
        { "key": "name", "label": "Name", "type": "text" },
        { "key": "from", "label": "Where they are", "type": "text" },
